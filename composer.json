{
  "name": "presentkim/session-utils",
  "description": "General-purpose player session management library for axolotl-pm/PocketMine-MP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "pocketmine/pocketmine-mp": "^5.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\utils\\session\\": "src/kim/present/utils/session/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\utils\\session\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
